{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Harness Session Plus",
  "version": "0.5.3",
  "identifier": "com.harness-session-plus.manager",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Harness Session Plus", "width": 1180, "height": 790, "minWidth": 920, "minHeight": 660, "center": true }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-src 'none'; form-action 'none'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
